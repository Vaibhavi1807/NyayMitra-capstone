# =========================================================
# NyayMitra Frontend — Environment
#
# Vite only reads .env files from the FRONTEND root, not
# from the repository root. These values are inlined into
# the bundle at build time (they must start with VITE_).
#
# Copy this file to `.env` and adjust if needed:
#     cp .env.example .env
# =========================================================

# Lawyer FastAPI service (profile, listing, practice areas)
VITE_API_BASE_URL=http://127.0.0.1:8000

# NLP / translation FastAPI service (translate, voice)
VITE_TRANSLATION_API_URL=http://127.0.0.1:8001

# Bearer key expected by the translation service
# (matches API_KEY in translate_service.py)
VITE_TRANSLATION_API_KEY=nyaymitra-local-test-2026

# Lawyer whose profile opens during development.
# After login this is overridden by the signed-in session.
VITE_LAWYER_ID=LAWYER_0003

# Auth mode: "mock" (no backend) or "api" (FastAPI /api/auth/login)
VITE_AUTH_MODE=mock

# Chat mode: "mock" (threads kept in localStorage, works offline)
# or "api" once FastAPI exposes the conversation endpoints.
VITE_CHAT_MODE=mock

# Authority mode: "mock" (admin's delegated-authority grants kept in
# localStorage) or "api" once /authorities exists.
VITE_AUTHORITY_MODE=mock
