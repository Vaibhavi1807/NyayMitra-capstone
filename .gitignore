# Case data - never commit raw / processed / scraped datasets
# data/ stays ignored. The only exceptions are the three resource files the
# intent + incident pipeline needs at runtime, un-ignored by exact path.
data/*
!data/raw/
data/raw/*
!data/raw/incident_examples.json
!data/raw/incident_categories.json
!data/raw/incident_facts.json
data/processed/
data/disposedata/

# Any CSV (case data, extracted tables, source dumps)
*.csv

# Data dumps
nyayMitra_data_v1.json

# Python
__pycache__/
*.pyc
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
.ipynb_checkpoints/

# Logs (NLP audit log, uvicorn, etc.)
*.log
access_audit.log

# Environment files
# Environment / secrets
.env
.env.*
!.env.example

# Node / frontend (if re-added later)
node_modules/
dist/

# Editors / OS
# OS / editor
.vscode/
.idea/
Thumbs.db
.DS_Store
